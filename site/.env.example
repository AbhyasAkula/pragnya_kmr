# Copy to .env.local (local) or set in your hosting provider. Never commit real secrets.
# .env* files are git-ignored; only this template is tracked.

# Public origin of the production site, e.g. the client's own domain over https.
# Leave empty until the domain is confirmed: the site then emits no canonical
# URLs, an empty sitemap and a noindex robots policy.
NEXT_PUBLIC_SITE_URL=

# Contact details (fictional placeholders are used when unset — see src/config/site.ts).
# Phone in international format; WhatsApp defaults to the phone number when unset.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Client's published, legally reviewed privacy policy (absolute URL or a site path
# such as /privacy). Linked from the booking form. Leave empty until it exists.
NEXT_PUBLIC_PRIVACY_POLICY_URL=

# --- Lead database (SERVER-ONLY SECRETS — never prefix with NEXT_PUBLIC_) -------
# Supabase → Project → Connect → "Supavisor". Use the pooler hosts: the direct
# db.<ref>.supabase.co host is IPv6-only and unreachable from most serverless
# platforms. URL-encode special characters in the password (e.g. @ → %40).
#
# Runtime (the website): TRANSACTION mode, port 6543.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
# Migrations (npm run db:migrate): SESSION mode, port 5432, scoped to the private schema.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&schema=aurelia"

# Recommended in production: Supabase's CA certificate (Database settings →
# SSL configuration → Download certificate), as PEM text with "\n" for line
# breaks. When set, the DB server certificate is fully verified.
DATABASE_SSL_CA=

# Optional: max connections per server instance (default 3).
DATABASE_POOL_MAX=

# Secret salt for hashing IPs/phone numbers in rate-limit keys (32+ chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_HASH_SECRET=
