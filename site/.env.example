# Copy to .env.local (local) or set in your hosting provider. Never commit real secrets.

# Public origin of the production site, e.g. the client's own domain over https.
# Leave empty until the domain is confirmed: the site then emits no canonical
# URLs, an empty sitemap and a noindex robots policy.
NEXT_PUBLIC_SITE_URL=

# Contact details (fictional placeholders are used when unset — see src/config/site.ts).
# Phone in international format; WhatsApp defaults to the phone number when unset.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
